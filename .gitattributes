# Skrip shell, unit systemd, dan Caddyfile HARUS berakhir LF. Kalau Git
# mengubahnya ke CRLF (default core.autocrlf=true di Windows), skrip gagal
# dijalankan di VPS dengan pesan "/usr/bin/env: 'bash\r': No such file".
*.sh            text eol=lf
Caddyfile       text eol=lf
*.service       text eol=lf

# Berkas aplikasi: biarkan Git menormalkan, tapi tetap LF di repo supaya
# bundel deploy konsisten.
*.py            text eol=lf
*.js            text eol=lf
*.css           text eol=lf
*.html          text eol=lf
*.md            text eol=lf
*.json          text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

# Aset biner jangan pernah disentuh.
*.png           binary
*.jpg           binary
*.jpeg          binary
*.webp          binary
*.gif           binary
*.mp4           binary
*.zip           binary
*.gz            binary
*.db            binary
