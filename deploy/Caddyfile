# =============================================================================
# Caddy untuk Affiliate Studio di VPS
# -----------------------------------------------------------------------------
# Dua alamat, satu aplikasi:
#
#   https://cpak.my.id                 domain utama
#   https://43-128-104-197.sslip.io    alamat lama, tetap hidup
#
# Keduanya memakai potongan (snippet) yang sama, jadi aturan keamanan dan
# batas waktu unggah tidak bisa berbeda diam-diam antara dua alamat.
#
# sslip.io dipertahankan karena tautan demo yang sudah beredar memakainya.
# Menghapusnya akan mematikan tautan itu tanpa memberi keuntungan apa pun.
#
# Catatan penerbitan sertifikat:
#   - Caddy menerbitkan sertifikat per hostname, otomatis, dan memperbaruinya
#     sendiri. Dua blok = dua sertifikat, tidak saling mengganggu.
#   - Syaratnya DNS A record sudah menunjuk ke VPS ini sebelum reload. Kalau
#     belum, ACME gagal dan Caddy mengulang dengan jeda makin panjang.
#   - Port 80 harus tetap terbuka: dipakai tantangan HTTP-01 dan redirect
#     otomatis ke HTTPS.
#
# Pasang:  sudo cp deploy/Caddyfile /etc/caddy/Caddyfile && sudo caddy validate \
#            --config /etc/caddy/Caddyfile && sudo systemctl reload caddy
# =============================================================================

{
	# Email kontak ACME sengaja TIDAK diisi.
	#
	# Percobaan pertama memakai placeholder admin@example.com dan Let's Encrypt
	# menolaknya: "contact email has forbidden domain example.com". Caddy lalu
	# diam-diam beralih ke ZeroSSL — tetap berhasil, tapi berisik di log.
	#
	# Tanpa kontak, Let's Encrypt menerima permintaan. Kalau ingin email
	# pengingat kedaluwarsa, isi dengan alamat nyata:
	#   email nama@domainasli.id
}

# ---------------------------------------------------------------------------
# Potongan bersama — dipakai oleh kedua alamat di bawah
# ---------------------------------------------------------------------------
(app) {
	encode zstd gzip

	# Lapis kedua. server.py sudah menolak semua ini (daftar putih ekstensi),
	# tapi menolaknya di tepi berarti permintaannya tidak pernah sampai ke
	# proses Python sama sekali.
	@rahasia path /data/* /.git/* /server.py /scripts/* /tests/* /hackathon/* /githooks/* /_upload* /.env /README.md
	respond @rahasia 404

	reverse_proxy 127.0.0.1:8787 {
		header_up X-Real-IP {remote_host}
		# unggah video 200 MB — jangan putus di tengah jalan
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}

	# Kalau URL ini akan dibagikan luas dan Bos tidak ingin ada orang iseng
	# mengubah data demo, buka tiga baris di bawah lalu jalankan
	# `caddy hash-password` untuk membuat hash-nya.
	#
	# basic_auth {
	# 	juri $2a$14$HASIL_DARI_caddy_hash-password
	# }
}

# ---------------------------------------------------------------------------
# Domain utama
# ---------------------------------------------------------------------------
cpak.my.id {
	import app
}

# ---------------------------------------------------------------------------
# Alamat lama — tetap dipertahankan supaya tautan yang sudah beredar hidup
# ---------------------------------------------------------------------------
43-128-104-197.sslip.io {
	import app
}

# ---------------------------------------------------------------------------
# Akses lewat IP mentah — dialihkan ke domain utama
# ---------------------------------------------------------------------------
http://43.128.104.197 {
	redir https://cpak.my.id{uri} permanent
}
