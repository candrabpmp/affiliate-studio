# database berisi kunci API LLM dan data produk nyata — jangan pernah ikut commit
data/
*.db
*.db-journal

# memori kerja dan artefak sementara
.workbuddy-ai/memory/
_t_*
*.bak-*
*.part

# video demo: 589 MB, GitHub menolak berkas > 100 MB — unggah ke Drive/YouTube
hackathon/*.mp4

# artefak WorkBuddy
.wbapp_*.genie

# sistem
__pycache__/
.DS_Store
Thumbs.db

# riwayat percakapan lengkap — berisi seluruh diskusi internal, bukan untuk
# repo publik secara default. Kalau memang mau dipublikasikan:
#   git add -f hackathon/RIWAYAT-CHAT.md
hackathon/RIWAYAT-CHAT.*

# transcript mentah — memuat API key sungguhan 42 kali. Jangan pernah masuk
# repo, bahkan sebagai riwayat. Untuk mengirim ke juri, pakai berkas di folder
# ini secara langsung, atau versi REDACTED.
hackathon/chat-history-raw/

# paket unggahan manual ke GitHub (dibuat ulang kapan saja)
_upload/
_upload.zip

# bundel deploy ke VPS: 54 MB, dibuat ulang oleh scripts/paket_deploy.py.
# Berisi database yang sudah dibersihkan, tapi tetap jangan masuk repo.
_deploy/

# folder pengumpulan: dokumen, sampul, hasil uji, dan transcript mentah.
# Dikirim lewat formulir pengumpulan, bukan lewat repo. Repo ini khusus
# kode yang bisa dijalankan.
hackathon/

# dependensi Node (hanya dipakai suite uji) dan hasil uji yang dihasilkan ulang
node_modules/
package-lock.json
tests/hasil-pengujian.html
tests/screenshot-hasil.png

# harness uji pipeline di browser (lokal, membaca kredensial dari _deploy/)
_uji/
